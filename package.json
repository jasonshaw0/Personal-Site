{
  "name": "jason-shaw-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test worker/contact-handler.test.ts",
    "types": "wrangler types --include-runtime false && wrangler types --config wrangler.contact.jsonc --env-interface ContactEnv --include-runtime false contact-configuration.d.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "deploy:contact": "wrangler deploy --config wrangler.contact.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  }
}
