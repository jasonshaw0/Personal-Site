{
  "name": "jason-shaw-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:blog": "astro dev",
    "check": "tsc --noEmit && astro check --tsconfig tsconfig.blog.json",
    "test": "node --test worker/*.test.ts",
    "test:blog": "node scripts/test-blog.mjs",
    "types": "wrangler types --include-runtime false && wrangler types --config wrangler.contact.jsonc --env-interface ContactEnv --include-runtime false contact-configuration.d.ts",
    "build": "npm run check && vite build && astro build && node scripts/merge-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:worker": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "deploy:contact": "wrangler deploy --config wrangler.contact.jsonc",
    "dev:admin": "vite --config admin/vite.config.ts",
    "check:admin": "tsc --project admin/tsconfig.json",
    "bundle:admin": "vite build --config admin/vite.config.ts",
    "build:admin": "npm run check:admin && npm run bundle:admin",
    "deploy:admin": "wrangler deploy --config admin/wrangler.jsonc",
    "types:admin": "wrangler types --config admin/wrangler.jsonc --env-interface AdminEnv --include-runtime false admin/env.d.ts",
    "test:admin": "node --experimental-transform-types --test admin/worker/*.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shikijs/rehype": "^4.5.0",
    "astro": "^7.4.0",
    "codemirror": "^6.0.2",
    "embla-carousel-react": "^8.6.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  }
}
