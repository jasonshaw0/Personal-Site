{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jasonshaw-admin",
  "account_id": "ccb39edc40a8735f0143eaaf430190a3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.jason-shaw.com",
      "custom_domain": true,
    },
  ],
  "build": {
    "command": "npm run bundle:admin",
    "cwd": ".",
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jasonshaw-admin",
      "database_id": "9de3679e-e821-44a7-a59b-ef0ba4e88c27",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 180,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ORIGIN": "https://admin.jason-shaw.com",
    "ACCESS_TEAM_DOMAIN": "https://jasonshaw.cloudflareaccess.com",
    "ACCESS_AUD": "7e68a90ad85a7d771bdacb9bd0943514703e2546aaed99b5d60a45223a83c4d6",
    "ADMIN_EMAIL": "jj@mountmyfish.com",
    "GITHUB_OWNER": "jasonshaw0",
    "GITHUB_REPO": "Personal-Site",
    "GITHUB_BRANCH": "main",
    "CF_ACCOUNT_ID": "ccb39edc40a8735f0143eaaf430190a3",
    "CF_ZONE_ID": "ff6567858c7029beac187d46df0810ab",
    "CF_SITE_TAG": "dc54abeb986d4af6ac26ce7b356217b1",
    "CF_PUBLIC_WORKER_TAG": "3cf8a0fbf97b4bc9a51ba59d091e4142",
    "CF_BLOCK_LIST_ID": "33f71e6dd30f435ab63e974b1a60faa9",
    "APP_VERSION": "2.0.0",
    "CF_BLOCK_RULESET_ID": "622100bb309d45569ea846413fb25ac8",
    "CF_BLOCK_RULE_ID": "a66b75ec4f0841988f1b5af9551886f0",
  },
}
