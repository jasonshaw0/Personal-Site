---
import { type Post, postUrl, formatDate, readingTime } from '../lib/posts'
interface Props { post: Post; compact?: boolean }
const { post, compact = false } = Astro.props
---
<article class="post-card">
  <div class="post-date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
  <div class="post-summary">
    <h3><a href={postUrl(post)}>{post.data.title}{!compact && <span class="post-arrow" aria-hidden="true">↗</span>}</a></h3>
    <p>{post.data.description}</p>
    <div class="post-meta"><ul aria-label="Tags">{post.data.tags.map(tag => <li><a href={`/blog?tag=${encodeURIComponent(tag)}#archive`}>{tag}</a></li>)}</ul><span>{readingTime(post)} min read</span>{compact && post.data.featured && <span>Featured</span>}</div>
  </div>
</article>
