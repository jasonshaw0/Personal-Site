{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jasonshaw-contact",
  "account_id": "ccb39edc40a8735f0143eaaf430190a3",
  "main": "worker/contact.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "contact.jason-shaw.com", "custom_domain": true }],
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "jj@mountmyfish.com" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
